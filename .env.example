# Copy this file to .env and fill in the values. Never commit .env.

# Access token from the Meta app dashboard (WhatsApp > API Setup).
# The temporary token expires after ~24 hours.
WHATSAPP_TOKEN=

# "Phone number ID" of the Meta test number (an ID, NOT the phone number itself).
PHONE_NUMBER_ID=

# Any random string you choose. You type the same value in the Meta webhook form.
VERIFY_TOKEN=

# Meta app secret (App settings > Basic). Used to verify webhook signatures.
APP_SECRET=

# Graph API version, as shown in the Meta dashboard's sample curl command.
GRAPH_API_VERSION=v23.0

# Port the Express server listens on.
PORT=3000

# Your own WhatsApp number: digits only, international format, no "+".
# It is attached to one of the fake customers so you can test from your phone.
TEST_CUSTOMER_PHONE=

# Anthropic API key (https://platform.claude.com) and Claude model ID.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
